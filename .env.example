# ---------------------------------------------------------------------------
# UPI Agent Trust Layer - environment
#
# Copy to `.env` and fill it in. RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET are
# REQUIRED: this service creates real orders against Razorpay's test mode and
# has no stubbed fallback, so it refuses to start without them.
# ---------------------------------------------------------------------------

# --- Razorpay -------------------------------------------------------------
# REQUIRED. TEST MODE KEYS ONLY. The app refuses to start if RAZORPAY_KEY_ID does not
# begin with `rzp_test_`, so a live key can never be used by an agent here.
# Get them from: Razorpay Dashboard -> Test Mode -> Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Anthropic ------------------------------------------------------------
# Only needed for `npm run demo:agent` and the dashboard's chat endpoint.
# Without it the demo runs in DIRECT MODE: intents go straight to the
# gatekeeper with no LLM in the loop. All four scenarios still run.
ANTHROPIC_API_KEY=
# Must be a model your key actually has access to - check console.anthropic.com.
AGENT_MODEL=claude-opus-5

# --- Server ---------------------------------------------------------------
PORT=3000

# --- Storage --------------------------------------------------------------
# Append-only SQLite audit trail. Deleted by the demo runner for a clean slate.
AUDIT_DB_PATH=data/audit.db

# The mandate in force. Swap this file to change what the agent may spend.
POLICY_PATH=src/config/policy.default.json
