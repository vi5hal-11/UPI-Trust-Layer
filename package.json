{
  "name": "upi-agent-trust-layer",
  "version": "1.0.0",
  "private": true,
  "description": "A deterministic policy gatekeeper between an AI shopping agent and Razorpay's payment APIs.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dashboard:dev": "vite",
    "build": "vite build",
    "prestart": "vite build",
    "start": "tsx src/server/index.ts",
    "serve": "tsx src/server/index.ts",
    "demo": "tsx scripts/demo-scenarios.ts",
    "demo:agent": "tsx scripts/demo-scenarios.ts --agent",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p dashboard/tsconfig.json && tsc --noEmit -p tests/e2e/tsconfig.json",
    "check:secrets": "tsx scripts/check-secrets.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "better-sqlite3": "^11.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^1.39.0",
    "motion": "^13.1.1",
    "openai": "^7.9.0",
    "razorpay": "^2.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.13",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
